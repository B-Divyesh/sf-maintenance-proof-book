{
  "name": "maintenance-proof-book",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inject-sw.mjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:claims": "playwright test --config=playwright.claims.config.ts",
    "test:production-browser": "node scripts/verify-production-browser.mjs",
    "test:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.1",
    "playwright-core": "^1.58.2",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
